X=int,input().split()
List=(X[1])
print(X)
Code1=List[List.index(max(List))]
Code=List[List.index(min(List))]
Total=sorted(List)
print(Total)
R=int(len(List)/2-1)
print(R)
first=int(Total[R])
last=int(Total[R+1])
if len(List)%2!=0:
    List=List[round(len(List)/2+1)]
    print(Code,Code1,List)
elif len(List)%2==0:
    List=(float(first+last/2))
    print(Code,Code1,List)
