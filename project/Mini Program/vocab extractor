#This code converts a string in a text file into line-separate words and saves it to a new file.

import re
import unicodedata

Path=open('your_chosen_drive:/file/file/file.txt','r')#Specify the path to the file to be converted. The file to be opened must end with .txt
Read_txt=Path.readlines()#Line by line reading the string
all_words=[]

for words in Read_txt:
    space=' '
    words = unicodedata.normalize('NFKC', words)
    words = re.sub(r"[^\w\s]", " ", words)#replace all the punctuation to ' '

    #if you dont want to import re and unicodata use this
    '''for i in ['.', '!', '?', ':', ',', "'", '"', '"',' ','(',')','[',']','=', '—', '–', '-']:
        words=words.replace(i,space)'''

    line_words=words.split()
    all_words.extend(line_words)

all_words=list(set(all_words))
all_words.sort()

result=open('your_chosen_drive:/file/file.txt','w')#Specify the result storage path
result.write('\n'.join(all_words))
result.close()#essential otherwise it will always be opreating not  printing the result
